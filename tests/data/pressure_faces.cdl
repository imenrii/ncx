netcdf pressure_faces {
dimensions:
  time = 4;
  node = 20;
  face = 12;
  nv = 4;
variables:
 double time(time);
  time:standard_name="time";
  time:units="hours since 2024-01-01 00:00:00Z";
 double lon(node);
  lon:standard_name="longitude";
  lon:units="degrees_east";
 double lat(node);
  lat:standard_name="latitude";
  lat:units="degrees_north";
 int mesh;
  mesh:cf_role="mesh_topology";
  mesh:topology_dimension=2;
  mesh:node_coordinates="lon lat";
  mesh:face_node_connectivity="face_nodes";
 int face_nodes(face,nv);
  face_nodes:start_index=0;
  face_nodes:cf_role="face_node_connectivity";
 float msl(time,face);
  msl:standard_name="air_pressure_at_mean_sea_level";
  msl:units="Pa";
  msl:mesh="mesh";
  msl:location="face";
 float u10(time,face);
  u10:standard_name="eastward_wind";
  u10:units="m/s";
  u10:mesh="mesh";
  u10:location="face";
 float v10(time,face);
  v10:standard_name="northward_wind";
  v10:units="m/s";
  v10:mesh="mesh";
  v10:location="face";
 :Conventions="CF-1.8 UGRID-1.0";
data:
  time = 0, 6, 12, 18;
  lon = 114.0, 114.25, 114.5, 114.75, 115.0, 114.0, 114.25, 114.5, 114.75, 115.0, 114.0, 114.25,
    114.5, 114.75, 115.0, 114.0, 114.25, 114.5, 114.75, 115.0;
  lat = 33.0, 33.0, 33.0, 33.0, 33.0, 33.25, 33.25, 33.25, 33.25, 33.25, 33.5, 33.5,
    33.5, 33.5, 33.5, 33.75, 33.75, 33.75, 33.75, 33.75;
  face_nodes = 0, 1, 6, 5, 1, 2, 7, 6, 2, 3, 8, 7,
    3, 4, 9, 8, 5, 6, 11, 10, 6, 7, 12, 11,
    7, 8, 13, 12, 8, 9, 14, 13, 10, 11, 16, 15,
    11, 12, 17, 16, 12, 13, 18, 17, 13, 14, 19, 18;
  msl = 100000, 100300, 100600, 100900, 100400, 100700, 101000, 101300, 100800, 101100, 101400, 101700,
    101000, 101300, 101600, 101900, 101400, 101700, 102000, 102300, 101800, 102100, 102400, 102700,
    102000, 102300, 102600, 102900, 102400, 102700, 103000, 103300, 102800, 103100, 103400, 103700,
    103000, 103300, 103600, 103900, 103400, 103700, 104000, 104300, 103800, 104100, 104400, 104700;
  u10 = 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3,
    6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6,
    9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9,
    12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12;
  v10 = 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4,
    8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8,
    12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12,
    16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16;
}
