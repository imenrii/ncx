netcdf wind {
dimensions:
  time = 4 ;
  lat = 2 ;
  lon = 3 ;
variables:
  double time(time) ;
    time:standard_name = "time" ;
    time:axis = "T" ;
    time:units = "hours since 2024-01-01 00:00:00Z" ;
  double lat(lat) ;
    lat:standard_name = "latitude" ;
    lat:units = "degrees_north" ;
  double lon(lon) ;
    lon:standard_name = "longitude" ;
    lon:units = "degrees_east" ;
  float msl(time, lat, lon) ;
    msl:standard_name = "air_pressure_at_mean_sea_level" ;
    msl:long_name = "Mean sea level pressure" ;
    msl:units = "Pa" ;
    msl:coordinates = "lon lat" ;
  float u10(time, lat, lon) ;
    u10:standard_name = "eastward_wind" ;
    u10:units = "m s-1" ;
    u10:coordinates = "lon lat" ;
    u10:_FillValue = -9999.f ;
  float v10(time, lat, lon) ;
    v10:standard_name = "northward_wind" ;
    v10:units = "m s-1" ;
    v10:coordinates = "lon lat" ;
    v10:_FillValue = -9999.f ;
  float t2m(time, lat, lon) ;
    t2m:standard_name = "air_temperature" ;
    t2m:units = "K" ;
    t2m:coordinates = "lon lat" ;
data:
  time = 0, 6, 12, 18 ;
  lat = 61, 60 ;
  lon = 0, 1, 3 ;
  msl = 100000, 100100, 100200, 100300, 100400, 100500,
        101000, 101100, 101200, 101300, 101400, 101500,
        102000, 102100, 102200, 102300, 102400, 102500,
        103000, 103100, 103200, 103300, 103400, 103500 ;
  u10 = 3, 0, -3, 3, 0, -9999,
        6, 0, -6, 6, 0, -9999,
        9, 0, -9, 9, 0, -9999,
        12, 0, -12, 12, 0, -9999 ;
  v10 = 4, 4, 4, -4, 0, -9999,
        8, 8, 8, -8, 0, -9999,
        12, 12, 12, -12, 0, -9999,
        16, 16, 16, -16, 0, -9999 ;
  t2m = 273.15, 274.15, 275.15, 276.15, 277.15, 278.15,
        274.15, 275.15, 276.15, 277.15, 278.15, 279.15,
        275.15, 276.15, 277.15, 278.15, 279.15, 280.15,
        276.15, 277.15, 278.15, 279.15, 280.15, 281.15 ;
}
