		Mesh2D_face_lon:units = "degrees_east" ;
	double Mesh2D_face_lat(nMesh2D_face) ;
		Mesh2D_face_lat:standard_name = "latitude" ;
		Mesh2D_face_lat:units = "degrees_north" ;
	double Mesh2D_edge_lon(nMesh2D_edge) ;
		Mesh2D_edge_lon:standard_name = "longitude" ;
		Mesh2D_edge_lon:units = "degrees_east" ;
	double Mesh2D_edge_lat(nMesh2D_edge) ;
		Mesh2D_edge_lat:standard_name = "latitude" ;
		Mesh2D_edge_lat:units = "degrees_north" ;
	int Mesh2D_face_nodes(nMesh2D_face, nMaxMesh2D_face_nodes) ;
		Mesh2D_face_nodes:cf_role = "face_node_connectivity" ;
		Mesh2D_face_nodes:start_index = 0 ;
		Mesh2D_face_nodes:_FillValue = -1 ;
	int Mesh2D_face_edges(nMesh2D_face, nMaxMesh2D_face_nodes) ;
		Mesh2D_face_edges:cf_role = "face_edge_connectivity" ;
		Mesh2D_face_edges:start_index = 0 ;
		Mesh2D_face_edges:_FillValue = -1 ;
	int Mesh2D_edge_nodes(nMesh2D_edge, Two) ;
		Mesh2D_edge_nodes:cf_role = "edge_node_connectivity" ;
