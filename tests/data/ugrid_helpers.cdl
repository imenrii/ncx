		water_velocity_normal:units = "m s-1" ;
		water_velocity_normal:_FillValue = -9999.f ;
		water_velocity_normal:long_name = "depth-averaged water velocity normal to edge" ;
		water_velocity_normal:comment = "positive from left face to right face" ;
	float transport_normal(time, nMesh2D_edge) ;
		transport_normal:mesh = "Mesh2D" ;
		transport_normal:location = "edge" ;
