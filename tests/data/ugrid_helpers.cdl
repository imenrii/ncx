		bathymetry:grid_mapping = "projected_coordinate_system" ;
		bathymetry:units = "m" ;
		bathymetry:standard_name = "sea_floor_depth_below_mean_sea_level" ;
	float upwind_land_roughness_reduction(nMesh2D_edge) ;
		upwind_land_roughness_reduction:mesh = "Mesh2D" ;
		upwind_land_roughness_reduction:location = "edge" ;
		upwind_land_roughness_reduction:coordinates = "Mesh2D_edge_x Mesh2D_edge_y Mesh2D_edge_lon Mesh2D_edge_lat" ;
		upwind_land_roughness_reduction:grid_mapping = "projected_coordinate_system" ;
		upwind_land_roughness_reduction:units = "1" ;
		upwind_land_roughness_reduction:long_name = "geometric-mean directional upwind land-roughness wind reduction factor" ;
		upwind_land_roughness_reduction:comment = "exp(a0) from logFr; excludes terrain shelter" ;
		upwind_land_roughness_reduction:_FillValue = -9999.f ;
	float bed_roughness_length(nMesh2D_edge) ;
		bed_roughness_length:mesh = "Mesh2D" ;
		bed_roughness_length:location = "edge" ;
		bed_roughness_length:coordinates = "Mesh2D_edge_x Mesh2D_edge_y Mesh2D_edge_lon Mesh2D_edge_lat" ;
		bed_roughness_length:grid_mapping = "projected_coordinate_system" ;
		bed_roughness_length:units = "m" ;
		bed_roughness_length:long_name = "unscaled hydrodynamic bed roughness length z0b" ;
		bed_roughness_length:_FillValue = -9999.f ;
	double Mesh2D_face_area(nMesh2D_face) ;
		Mesh2D_face_area:mesh = "Mesh2D" ;
		Mesh2D_face_area:location = "face" ;
		Mesh2D_face_area:coordinates = "Mesh2D_face_x Mesh2D_face_y Mesh2D_face_lon Mesh2D_face_lat" ;
		Mesh2D_face_area:grid_mapping = "projected_coordinate_system" ;
		Mesh2D_face_area:units = "m2" ;
	double Mesh2D_edge_length(nMesh2D_edge) ;
		Mesh2D_edge_length:mesh = "Mesh2D" ;
		Mesh2D_edge_length:location = "edge" ;
		Mesh2D_edge_length:coordinates = "Mesh2D_edge_x Mesh2D_edge_y Mesh2D_edge_lon Mesh2D_edge_lat" ;
		Mesh2D_edge_length:grid_mapping = "projected_coordinate_system" ;
		Mesh2D_edge_length:units = "m" ;
	double Mesh2D_edge_normal_x(nMesh2D_edge) ;
		Mesh2D_edge_normal_x:mesh = "Mesh2D" ;
		Mesh2D_edge_normal_x:location = "edge" ;
		Mesh2D_edge_normal_x:coordinates = "Mesh2D_edge_x Mesh2D_edge_y Mesh2D_edge_lon Mesh2D_edge_lat" ;
		Mesh2D_edge_normal_x:grid_mapping = "projected_coordinate_system" ;
		Mesh2D_edge_normal_x:units = "1" ;
		Mesh2D_edge_normal_x:comment = "unit normal, positive from left face to right face" ;
	double Mesh2D_edge_normal_y(nMesh2D_edge) ;
		Mesh2D_edge_normal_y:mesh = "Mesh2D" ;
		Mesh2D_edge_normal_y:location = "edge" ;
		Mesh2D_edge_normal_y:coordinates = "Mesh2D_edge_x Mesh2D_edge_y Mesh2D_edge_lon Mesh2D_edge_lat" ;
		Mesh2D_edge_normal_y:grid_mapping = "projected_coordinate_system" ;
		Mesh2D_edge_normal_y:units = "1" ;
		Mesh2D_edge_normal_y:comment = "unit normal, positive from left face to right face" ;
	ubyte Mesh2D_edge_type(nMesh2D_edge) ;
		Mesh2D_edge_type:mesh = "Mesh2D" ;
		Mesh2D_edge_type:location = "edge" ;
